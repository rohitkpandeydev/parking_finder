PORT=3000

# Preferred for AWS RDS
RDS_HOST=your-rds-endpoint.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=parking_finder
RDS_USERNAME=postgres
RDS_PASSWORD=replace_me

# Optional fallback naming
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=parking_finder
# DB_USER=postgres
# DB_PASSWORD=postgres

# SSL is typically required for RDS
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d
